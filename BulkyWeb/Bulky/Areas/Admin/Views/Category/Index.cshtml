@using BulkyWeb.Model.Models
@model List<Category>

<partial name="_Notification" />


    <div class="container">
            <div class= row pt-4 pb-23>
                <div class="col-6">
                    <h2 class="text-primary">
                        Category List
                    </h2>
                </div>
                <div class="col-6 text-end">
                    <a asp-controller="Category" asp-action="Create" class="btn btn-primary">
                        <i class="bi bi-plus-circle"> Create New Category</i>
                    </a>

                </div>
            </div>
    </div> 



<table class="table table-bordered table-striped" >

    <thead>
        <tr>
            <td>Category Name</td>
            <td>Display Order</td>
        </tr>

    </thead>
    <tbody>
        @foreach (var category in Model.OrderBy(c => c.DisplayOrder))
        {
            <tr>
                <td>@category.Name</td>
                <td>@category.DisplayOrder</td>
                <td>
                    <div class="w-75 btn-group" role="group">
                        <a asp-controller="Category" asp-route-id="@category.Id" asp-action="Edit" class="btn btn-primary mx-2">
                            <i class="bi bi-pencil-square"></i>Edit
                        </a>
                        <a asp-controller="Category" asp-route-id="@category.Id" asp-action="Delete" class="btn btn-danger mx-2">
                            <i class="bi bi-trash-fill"></i>Delete
                        </a>
                    </div>
                </td>
            </tr>   
        }

    </tbody>
    
</table>